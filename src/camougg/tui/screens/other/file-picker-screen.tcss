/* ===========================
   File Picker Modal
   =========================== */

FilePickerScreen {
    align: center middle;
}

#picker_container {
    width: 80%;
    height: 80%;
    background: $panel;
    border: round $accent;
    padding: 1 2;
}

#picker_title {
    width: 100%;
    height: 1;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#picker_current_path {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    color: $text-muted;
}

#picker_tree {
    width: 100%;
    height: 1fr;
    border: round $primary;
    margin-bottom: 1;
}

#picker_goto_row {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#picker_goto_input {
    width: 1fr;
    margin-right: 1;
}

#goto_btn {
    width: 10;
}

#picker_buttons {
    width: 100%;
    height: 3;
}

.picker_spacer {
    width: 1fr;
}

#select_dir_btn {
    width: 1fr;
    margin-right: 1;
}

#cancel_btn {
    width: 20;
}

.menu_button.cancel {
    border: round $error;
    color: $error;
}

.menu_button.cancel:hover {
    background: $error 25%;
    color: $text;
}

.menu_button.cancel:focus {
    border: round $error;
    background: $error 20%;
}