/* ===========================
   Screen
   =========================== */

Screen {
    background: $surface;
    color: $text;
}


/* ===========================
   Header / Footer
   =========================== */

Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $primary;
    color: $text;
}


/* ===========================
   Main Container
   =========================== */

Vertical {
    padding: 1 2;
}


/* ===========================
   Logo
   =========================== */

#logo {
    width: 100%;
    text-align: left;

    color: $primary;

    margin-bottom: 1;
}


/* ===========================
   Section titles
   =========================== */

.section_title {
    color: $primary;
    text-style: bold;

    margin-top: 1;
    margin-bottom: 1;
}


/* ===========================
   RadioSet
   =========================== */

RadioSet {
    border: round $primary;

    background: $panel;

    padding: 1 2;

    margin-bottom: 1;
}


/* Unselected */

RadioButton {
    color: $text;
}


/* Selected */

RadioButton.-selected {
    color: $primary;
    text-style: bold;
}


/* Hover */

RadioButton:hover {
    background: $boost;
}


/* ===========================
   RichLog
   =========================== */

RichLog {

    height: 1fr;

    border: none;

    background: transparent;

    color: $text;

    padding-top: 1;
}


/* ===========================
   Input
   =========================== */

Input {

    border: none;

    background: transparent;

    color: $primary;

    margin-top: 1;
}


/* ===========================
   Optional status blocks
   =========================== */

.info_box {

    border: round $primary;

    background: $panel;

    padding: 1 2;

    color: $text;

    margin-bottom: 1;
}


/* ===========================
   Static widgets
   =========================== */

Static {

    color: $text;

}


/* ===========================
   Scrollbar
   =========================== */

ScrollBar {

    background: $surface;

}

ScrollBar > .scrollbar--handle {

    background: $primary;

}


/* ===========================
   Focus
   =========================== */

*:focus {

    border: round $accent;

}


/* ===========================
   Disabled
   =========================== */

*:disabled {

    color: $text-disabled;

}