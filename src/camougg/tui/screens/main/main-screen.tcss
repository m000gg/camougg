/* ===========================
   Screen
   =========================== */

Screen {
    background: $surface;
    color: $text;
}

Header {
    background: $primary;
    color: $text;
}

Footer {
    background: $primary;
    color: $text;
}


/* ===========================
   Root layout
   =========================== */

#root {
    padding: 1 2;
    align: center top;
}


/* ===========================
   Logo
   =========================== */

#logo {
    width: 100%;
    text-align: left;
    color: $primary;
    margin-bottom: 1;
}


/* ===========================
   Section titles
   =========================== */

.section_title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}


/* ===========================
   Menu container
   =========================== */

#menu_container {
    width: 90;
    max-width: 100%;
    height: auto;

    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;

    background: $panel;

    padding: 1 3;
}


/* ===========================
   Menu rows (button + description)
   =========================== */

.menu_row {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

.menu_row:last-of-type {
    margin-bottom: 0;
}


/* ===========================
   Menu buttons
   =========================== */

.menu_button {
    width: 22;
    height: 3;

    content-align: left middle;
    text-style: bold;

    background: $boost;
    border: round $primary-lighten-2;
}

.menu_button:hover {
    background: $accent 20%;
    text-style: bold reverse;
}

.menu_button:focus {
    border: round $accent;
}

.menu_button.photo {
    border: round $success;
    color: $success;
}

.menu_button.photo:hover {
    background: $success 25%;
    color: $text;
}

.menu_button.video {
    border: round $primary;
    color: $primary;
}

.menu_button.video:hover {
    background: $primary 25%;
    color: $text;
}

.menu_button.audio {
    border: round $warning;
    color: $warning;
}

.menu_button.audio:hover {
    background: $warning 25%;
    color: $text;
}


/* ===========================
   Descriptions
   =========================== */

.menu_desc {
    width: 1fr;
    height: 3;

    content-align: left middle;
    padding-left: 2;

    color: $text-muted;
    text-style: italic;
}


/* ===========================
   Focus
   =========================== */

*:focus {
    border: round $accent;
}